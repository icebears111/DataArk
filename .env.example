# DataArk 环境变量配置

# ----- LLM 配置（三选一）-----

# 方式1: Qwen 通义千问（通过阿里云百炼 DashScope）
# 去 https://bailian.console.aliyun.com/ 获取 API Key
# 模型可选: qwen-turbo, qwen-plus, qwen-max, qwen2.5-72b-instruct
LLM_API_KEY=your-dashscope-api-key
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 方式2: OpenAI 兼容 API（支持 GPT、DeepSeek、GLM 等）
# DeepSeek:  base=https://api.deepseek.com           model=deepseek-chat
# GLM:        base=https://open.bigmodel.cn/api/paas/v4  model=glm-4-flash
# LLM_API_KEY=your-api-key-here
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 方式3: Ollama 本地模型
# 先安装 Ollama: https://ollama.com
# 然后拉模型: ollama pull qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ----- Embedding 配置（文档向量化用）-----
# Qwen DashScope 不需要改，默认就是 text-embedding-v2
# OpenAI: EMBEDDING_MODEL=text-embedding-3-small
#         EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ----- JWT 密钥（生产环境务必修改！）-----
# SECRET_KEY=change-this-to-a-random-string
